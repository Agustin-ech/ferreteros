# Base de Datos
SQLALCHEMY_DATABASE_URI=postgresql://usuario:password@host:5432/nombre_db

# Seguridad JWT: mínimo 32 caracteres aleatorios (la app no arranca con menos).
# Usa una distinta en cada entorno. Genérala con:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=

# Fotos de productos (Supabase Storage). Solo en el backend.
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_KEY=clave_service_role_secreta
SUPABASE_BUCKET=ferreteros
